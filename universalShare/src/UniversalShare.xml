<?xml version="1.0" encoding="utf-8" ?>
<widget
    id="mendix.universalshare.UniversalShare"
    pluginWidget="true"
    needsEntityContext="true"
    offlineCapable="true"
    supportedPlatform="Web"
    xmlns="http://www.mendix.com/widget/1.0/"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.mendix.com/widget/1.0/ ../node_modules/mendix/custom_widget.xsd"
>
    <name>Universal Share</name>
    <description>Share buttons for 22 social networks, messengers and email, with the URL, title and hashtags from attributes.</description>
    <studioProCategory>Display</studioProCategory>
    <icon>
        
    </icon>
    <properties>
        <propertyGroup caption="General">
            <propertyGroup caption="Content">
                <property key="urlKey" type="attribute" required="false">
                    <caption>URL</caption>
                    <description>String attribute with the URL to share. Empty: the URL of the current page.</description>
                    <attributeTypes>
                        <attributeType name="String" />
                    </attributeTypes>
                </property>
                <property key="titleKey" type="attribute" required="false">
                    <caption>Title</caption>
                    <description>
                        String attribute with the title or message. Used by X, LinkedIn, WhatsApp, Telegram, Reddit,
                        Bluesky, Threads and most other platforms, and as the email subject.
                    </description>
                    <attributeTypes>
                        <attributeType name="String" />
                    </attributeTypes>
                </property>
                <property key="descriptionKey" type="attribute" required="false">
                    <caption>Description</caption>
                    <description>
                        String attribute with a longer text. Used as the email body and by LinkedIn, Pinterest, Tumblr,
                        OK, Mail.ru, Instapaper and LiveJournal.
                    </description>
                    <attributeTypes>
                        <attributeType name="String" />
                    </attributeTypes>
                </property>
                <property key="hashtagsKey" type="attribute" required="false">
                    <caption>Hashtags</caption>
                    <description>
                        String attribute with comma-separated hashtags, for example mendix,lowcode (a leading # is
                        allowed). Used by X and Tumblr, added to the text for Threads and Bluesky; Facebook uses the first one.
                    </description>
                    <attributeTypes>
                        <attributeType name="String" />
                    </attributeTypes>
                </property>
                <property key="imageUrlKey" type="attribute" required="false">
                    <caption>Image URL</caption>
                    <description>
                        String attribute with the URL of an image. Required for Pinterest; also used by VK, OK, Mail.ru
                        and Weibo.
                    </description>
                    <attributeTypes>
                        <attributeType name="String" />
                    </attributeTypes>
                </property>
                <property key="facebookAPPIDKey" type="attribute" required="false">
                    <caption>Facebook App ID</caption>
                    <description>String attribute with your Facebook App ID. Required for Messenger.</description>
                    <attributeTypes>
                        <attributeType name="String" />
                    </attributeTypes>
                </property>
            </propertyGroup>
            <propertyGroup caption="Platforms">
                <property key="platformsKey" type="attribute" required="true">
                    <caption>Platforms</caption>
                    <description>
                        String attribute with the platforms, comma-separated, in the order they are shown: bluesky,
                        email, facebook, messenger, gab, hatena, instapaper, line, linkedin, livejournal, mailru, ok,
                        pinterest, reddit, telegram, threads, tumblr, viber, vk, weibo, whatsapp, twitter (or x).
                        Upper case and spaces are ignored; unknown names are skipped.
                    </description>
                    <attributeTypes>
                        <attributeType name="String" />
                    </attributeTypes>
                </property>
            </propertyGroup>
        </propertyGroup>
        <propertyGroup caption="Appearance">
            <propertyGroup caption="Icons">
                <property key="iconSize" type="integer" required="true" defaultValue="40">
                    <caption>Icon size</caption>
                    <description>Size of the icons in pixels (16 to 128).</description>
                </property>
                <property key="roundIcons" type="boolean" required="true" defaultValue="true">
                    <caption>Round icons</caption>
                    <description>Yes: round icons. No: square icons with rounded corners.</description>
                </property>
                <property key="visibleCount" type="integer" required="true" defaultValue="6">
                    <caption>Icons before More</caption>
                    <description>
                        Number of icons shown before the + (More) button. The other icons open in a panel below. 0: all
                        icons are shown, without a More button.
                    </description>
                </property>
            </propertyGroup>
        </propertyGroup>
    </properties>
</widget>
